# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM extraction (intake/extraction only). Leave empty to run without the LLM:
# classification and the text layer still work, extraction writes "llm_skipped" placeholders.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Database (DB team). SQLite is fine for local dev.
DATABASE_URL=sqlite:///./backend/ap.db

# Business "today". Never use the real clock in business logic.
AS_OF_DATE=2026-11-02

# Leave empty to use the repo's dataset/brim_ap_dataset
DATASET_DIR=

# Audit log: key for the HMAC fingerprints of bank account numbers. Must be 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=
