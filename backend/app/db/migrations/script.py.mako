## Template Alembic uses for every new migration file (`alembic revision [--autogenerate] -m "..." --rev-id 0002`).
## Lines starting with ## are Mako comments and are not copied into the generated file.
## Generated files must pass `ruff check`, so the imports and type hints below follow the repo's ruff rules.
## Every migration needs a downgrade() that fully reverses upgrade(); review autogenerated code by hand.
"""${message}

Revision ID: ${up_revision}
Revises: ${down_revision | comma,n}
Create Date: ${create_date}
"""
from collections.abc import Sequence

import sqlalchemy as sa
from alembic import op
${imports if imports else ""}

# Revision identifiers, used by Alembic to order migrations.
revision: str = ${repr(up_revision)}
down_revision: str | Sequence[str] | None = ${repr(down_revision)}
branch_labels: str | Sequence[str] | None = ${repr(branch_labels)}
depends_on: str | Sequence[str] | None = ${repr(depends_on)}


def upgrade() -> None:
    """Apply this migration."""
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    """Fully reverse upgrade()."""
    ${downgrades if downgrades else "pass"}
